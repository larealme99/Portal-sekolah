<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Portal Guru & Ruang Siswa - Simpul Smandum</title>
  <link rel="manifest" href="manifest.json">
  <meta name="theme-color" content="#0284c7">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Supabase JS Client CDN -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <!-- Load Konfigurasi Supabase Eksisting Sekolah -->
  <script src="../supabase-config.js"></script>

  <style>
    :root {
      --primary: #0284c7;
      --primary-dark: #0369a1;
      --primary-light: #38bdf8;
      --primary-subtle: #e0f2fe;
      --primary-gradient: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
      --accent-green: #10b981;
      --accent-yellow: #f59e0b;
      --accent-red: #ef4444;
      --bg-canvas: #f1f5f9;
      --bg-card: #ffffff;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border-color: #e2e8f0;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --shadow-soft: 0 4px 20px -2px rgba(15, 23, 42, 0.06);
      --shadow-hover: 0 10px 25px -4px rgba(2, 132, 199, 0.15);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--bg-canvas);
      color: var(--text-main);
      display: flex;
      justify-content: center;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Container HP Mobile Simulator */
    .app-viewport {
      width: 100%;
      max-width: 440px;
      min-height: 100vh;
      background: #f8fafc;
      position: relative;
      box-shadow: 0 0 40px rgba(0,0,0,0.12);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* Top Status Bar Mockup */
    .mobile-status-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 20px 6px;
      font-size: 13px;
      font-weight: 700;
      color: #0f172a;
      background: #ffffff;
      z-index: 50;
      border-bottom: 1px solid #f1f5f9;
    }
    .status-bar-icons {
      display: flex;
      gap: 6px;
      align-items: center;
    }
    .sync-indicator {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 10px;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 6px;
      background: #dcfce7;
      color: #15803d;
    }
    .sync-indicator.syncing {
      background: #fef3c7;
      color: #b45309;
    }
    .sync-indicator.offline {
      background: #fee2e2;
      color: #b91c1c;
    }

    /* Content Area Scrollable */
    .app-screen {
      flex: 1;
      overflow-y: auto;
      padding-bottom: 90px;
      display: none;
    }
    .app-screen.active {
      display: block;
      animation: fadeIn 0.25s ease-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Top App Bar Header */
    .screen-header {
      padding: 14px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #ffffff;
      border-bottom: 1px solid #f1f5f9;
      position: sticky;
      top: 0;
      z-index: 40;
    }
    .screen-header h2 {
      font-size: 17px;
      font-weight: 800;
      color: #0f172a;
    }
    .back-btn {
      background: #f1f5f9;
      border: none;
      font-size: 18px;
      cursor: pointer;
      color: #334155;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 50%;
    }
    .back-btn:active {
      background: #e2e8f0;
    }

    /* ============================================================ */
    /* 1. LAYAR LOGIN */
    /* ============================================================ */
    #screen-login {
      background: linear-gradient(180deg, #f0f9ff 0%, #ffffff 40%, #0284c7 100%);
      min-height: 100vh;
      display: none;
      flex-direction: column;
      justify-content: space-between;
      padding: 24px 20px;
      position: relative;
    }
    #screen-login.active {
      display: flex;
    }
    .login-brand {
      text-align: center;
      margin-top: 10px;
    }
    .login-brand-icon {
      width: 72px;
      height: 72px;
      margin: 0 auto 10px;
      background: #ffffff;
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 10px 25px rgba(2, 132, 199, 0.2);
    }
    .login-brand-icon img {
      width: 48px;
      height: 48px;
      object-fit: contain;
    }
    .login-brand h1 {
      font-size: 24px;
      font-weight: 800;
      color: #0284c7;
      letter-spacing: -0.5px;
    }
    .login-brand p {
      font-size: 12px;
      color: #64748b;
      margin-top: 2px;
      font-weight: 500;
    }

    .login-card {
      background: #ffffff;
      border-radius: 22px;
      padding: 22px;
      box-shadow: 0 15px 35px rgba(2, 132, 199, 0.12);
      margin-top: 16px;
    }
    .login-card-title {
      font-size: 18px;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 4px;
    }
    .login-card-sub {
      font-size: 12px;
      color: #64748b;
      margin-bottom: 16px;
    }

    .role-switcher {
      display: flex;
      background: #f1f5f9;
      border-radius: 12px;
      padding: 4px;
      margin-bottom: 16px;
    }
    .role-btn {
      flex: 1;
      padding: 8px 10px;
      border: none;
      background: transparent;
      border-radius: 9px;
      font-size: 13px;
      font-weight: 700;
      color: #64748b;
      cursor: pointer;
      transition: all 0.2s;
    }
    .role-btn.active {
      background: #ffffff;
      color: #0284c7;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .form-group {
      margin-bottom: 14px;
    }
    .form-group label {
      display: block;
      font-size: 12px;
      font-weight: 700;
      color: #475569;
      margin-bottom: 6px;
    }
    .input-box {
      display: flex;
      align-items: center;
      background: #f8fafc;
      border: 1.5px solid #e2e8f0;
      border-radius: 14px;
      padding: 12px 14px;
      gap: 10px;
      transition: border-color 0.2s;
    }
    .input-box:focus-within {
      border-color: #0284c7;
      background: #ffffff;
    }
    .input-box input {
      border: none;
      background: transparent;
      outline: none;
      width: 100%;
      font-size: 14px;
      color: #0f172a;
    }
    .btn-primary {
      width: 100%;
      padding: 13px;
      background: var(--primary-gradient);
      color: white;
      border: none;
      border-radius: 14px;
      font-size: 14px;
      font-weight: 800;
      cursor: pointer;
      margin-top: 8px;
      box-shadow: 0 8px 20px rgba(2, 132, 199, 0.3);
      transition: transform 0.15s;
    }
    .btn-primary:active {
      transform: scale(0.98);
    }
    .login-footer-quote {
      text-align: center;
      color: #ffffff;
      font-size: 11px;
      opacity: 0.9;
      padding: 10px 0;
    }

    /* ============================================================ */
    /* 2. LAYAR BERANDA (HOME) */
    /* ============================================================ */
    .home-header {
      padding: 12px 20px 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #ffffff;
    }
    .user-profile-badge {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .user-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: #e0f2fe;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      border: 2px solid #bae6fd;
      overflow: hidden;
    }
    .user-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .user-greeting {
      font-size: 11px;
      color: #64748b;
      font-weight: 600;
    }
    .user-name {
      font-size: 15px;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.2;
    }
    .user-role-badge {
      font-size: 11px;
      color: #0284c7;
      font-weight: 700;
    }
    .bell-btn {
      position: relative;
      background: #f1f5f9;
      border: none;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 18px;
    }
    .bell-badge {
      position: absolute;
      top: -2px;
      right: -2px;
      background: #ef4444;
      color: white;
      font-size: 10px;
      font-weight: 800;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid #ffffff;
    }

    .school-id-card {
      margin: 12px 20px;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 12px 14px;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .school-id-icon {
      width: 38px;
      height: 38px;
      background: #e0f2fe;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }
    .school-id-title {
      font-size: 13px;
      font-weight: 800;
      color: #0f172a;
    }
    .school-id-year {
      font-size: 11px;
      color: #64748b;
      font-weight: 500;
    }

    /* PENGINGAT JADWAL 20 MENIT REAL-TIME */
    .urgent-reminder-box {
      margin: 0 20px 16px;
      background: #fffbeb;
      border: 1.5px solid #fde68a;
      border-radius: 18px;
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      box-shadow: 0 4px 12px rgba(245, 158, 11, 0.1);
      transition: all 0.3s;
    }
    .reminder-header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .reminder-badge-urgent {
      background: #d97706;
      color: white;
      font-size: 11px;
      font-weight: 800;
      padding: 3px 8px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .reminder-time-left {
      font-size: 12px;
      font-weight: 800;
      color: #b45309;
    }
    .reminder-class-info {
      font-size: 14px;
      font-weight: 800;
      color: #78350f;
    }
    .reminder-student-roster {
      font-size: 11px;
      color: #92400e;
      line-height: 1.4;
      background: rgba(255, 255, 255, 0.7);
      padding: 8px 10px;
      border-radius: 10px;
      border: 1px solid #fef3c7;
    }
    .btn-quick-absen {
      background: #d97706;
      color: white;
      border: none;
      padding: 9px;
      border-radius: 10px;
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .quote-banner {
      margin: 0 20px 18px;
      background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
      border-radius: 20px;
      padding: 18px 20px;
      color: white;
      position: relative;
      overflow: hidden;
      box-shadow: 0 10px 20px rgba(2, 132, 199, 0.18);
    }
    .quote-banner h3 {
      font-size: 14px;
      font-weight: 800;
      max-width: 75%;
      line-height: 1.4;
    }
    .quote-banner p {
      font-size: 11px;
      opacity: 0.9;
      margin-top: 4px;
    }
    .quote-banner-icon {
      position: absolute;
      right: 16px;
      bottom: 16px;
      width: 36px;
      height: 36px;
      background: rgba(255, 255, 255, 0.2);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
    }

    .quick-menu-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin: 0 20px 18px;
    }
    .menu-card {
      background: #ffffff;
      border-radius: 18px;
      padding: 16px 8px;
      text-align: center;
      border: 1px solid #f1f5f9;
      box-shadow: var(--shadow-soft);
      cursor: pointer;
      transition: all 0.2s;
    }
    .menu-card:active {
      transform: scale(0.96);
      background: #f8fafc;
    }
    .menu-card-icon {
      width: 46px;
      height: 46px;
      border-radius: 14px;
      background: #0284c7;
      color: #ffffff;
      margin: 0 auto 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25);
    }
    .menu-card-title {
      font-size: 11px;
      font-weight: 700;
      color: #334155;
    }

    .announcement-banner {
      margin: 0 20px 18px;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 12px 14px;
      display: flex;
      align-items: center;
      gap: 12px;
      cursor: pointer;
    }
    .announcement-icon {
      width: 36px;
      height: 36px;
      background: #0284c7;
      color: white;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }
    .announcement-text {
      flex: 1;
    }
    .announcement-tag {
      font-size: 12px;
      font-weight: 800;
      color: #0f172a;
    }
    .announcement-sub {
      font-size: 11px;
      color: #64748b;
    }

    /* ============================================================ */
    /* 3. LAYAR DAFTAR KELAS */
    /* ============================================================ */
    .search-bar-wrap {
      padding: 12px 20px;
    }
    .search-input-box {
      display: flex;
      align-items: center;
      background: #ffffff;
      border: 1.5px solid #e2e8f0;
      border-radius: 14px;
      padding: 10px 14px;
      gap: 10px;
    }
    .search-input-box input {
      border: none;
      outline: none;
      width: 100%;
      font-size: 13px;
    }
    .class-card-list {
      padding: 0 20px 20px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .class-item-card {
      background: #ffffff;
      border-radius: 16px;
      padding: 14px;
      display: flex;
      align-items: center;
      gap: 14px;
      border: 1px solid #f1f5f9;
      box-shadow: var(--shadow-soft);
      cursor: pointer;
    }
    .class-badge-icon {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      background: #0284c7;
      color: white;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      line-height: 1;
    }
    .class-badge-icon span:first-child { font-size: 14px; }
    .class-badge-icon span:last-child { font-size: 10px; opacity: 0.9; margin-top: 2px; }
    .class-info-detail {
      flex: 1;
    }
    .class-info-name {
      font-size: 14px;
      font-weight: 800;
      color: #0f172a;
    }
    .class-info-sub {
      font-size: 12px;
      color: #64748b;
      margin-top: 2px;
    }

    /* ============================================================ */
    /* 4. LAYAR JADWAL MENGAJAR */
    /* ============================================================ */
    .schedule-date-filter {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin: 12px 20px;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 14px;
      padding: 10px 16px;
      font-size: 13px;
      font-weight: 800;
      color: #0f172a;
    }
    .schedule-list {
      padding: 0 20px 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .schedule-card {
      background: #ffffff;
      border-radius: 18px;
      padding: 16px;
      border: 1px solid #f1f5f9;
      box-shadow: var(--shadow-soft);
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .schedule-time-box {
      width: 44px;
      height: 44px;
      border-radius: 14px;
      background: #0284c7;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }
    .schedule-detail {
      flex: 1;
    }
    .schedule-time-range {
      font-size: 11px;
      color: #64748b;
      font-weight: 700;
    }
    .schedule-title {
      font-size: 14px;
      font-weight: 800;
      color: #0f172a;
      margin-top: 2px;
    }
    .schedule-sub {
      font-size: 12px;
      color: #64748b;
    }
    .schedule-status-badge {
      font-size: 11px;
      font-weight: 800;
      padding: 4px 10px;
      border-radius: 10px;
    }
    .status-terlaksana {
      background: #dcfce7;
      color: #15803d;
    }
    .status-berlangsung {
      background: #dbeafe;
      color: #1d4ed8;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .status-belum-mulai {
      background: #f1f5f9;
      color: #64748b;
    }

    /* ============================================================ */
    /* 5. LAYAR ABSEN SISWA */
    /* ============================================================ */
    .attendance-stats-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      margin: 12px 20px;
    }
    .stat-pill {
      background: #ffffff;
      border-radius: 14px;
      padding: 10px 4px;
      text-align: center;
      border: 1px solid #f1f5f9;
      box-shadow: var(--shadow-soft);
    }
    .stat-pill-num {
      font-size: 18px;
      font-weight: 800;
    }
    .stat-pill-label {
      font-size: 10px;
      font-weight: 700;
      color: #64748b;
      margin-top: 2px;
    }
    .roster-card {
      background: #ffffff;
      border-radius: 16px;
      padding: 12px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border: 1px solid #f1f5f9;
      box-shadow: var(--shadow-soft);
      margin-bottom: 8px;
    }
    .roster-info {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .roster-avatar {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: #f1f5f9;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
    }
    .roster-name {
      font-size: 13px;
      font-weight: 800;
      color: #0f172a;
    }
    .roster-nis {
      font-size: 11px;
      color: #64748b;
    }
    .status-tag-toggle {
      font-size: 11px;
      font-weight: 800;
      padding: 6px 12px;
      border-radius: 10px;
      border: none;
      cursor: pointer;
      min-width: 60px;
      text-align: center;
    }
    .tag-hadir { background: #dcfce7; color: #15803d; }
    .tag-izin { background: #fef3c7; color: #b45309; }
    .tag-sakit { background: #fee2e2; color: #b91c1c; }
    .tag-alpa { background: #f1f5f9; color: #475569; }

    .btn-save-attendance {
      width: calc(100% - 40px);
      margin: 10px 20px 20px;
      padding: 14px;
      background: var(--accent-green);
      color: white;
      border: none;
      border-radius: 14px;
      font-size: 14px;
      font-weight: 800;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    /* Modal Pop-up Notifikasi 20 Menit */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(4px);
      z-index: 100;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .modal-overlay.active {
      display: flex;
    }
    .modal-box {
      background: #ffffff;
      border-radius: 24px;
      padding: 24px;
      width: 100%;
      max-width: 380px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.25);
      animation: popIn 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    @keyframes popIn {
      from { transform: scale(0.9); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }
    .modal-icon-bell {
      width: 56px;
      height: 56px;
      border-radius: 18px;
      background: #fef3c7;
      color: #d97706;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      margin: 0 auto 14px;
    }

    /* BOTTOM NAVIGATION */
    .bottom-nav {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 72px;
      background: #ffffff;
      border-top: 1px solid #f1f5f9;
      display: flex;
      justify-content: space-around;
      align-items: center;
      padding: 0 10px;
      z-index: 45;
      box-shadow: 0 -4px 20px rgba(0,0,0,0.03);
    }
    .nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      background: none;
      border: none;
      color: #64748b;
      cursor: pointer;
      font-size: 11px;
      font-weight: 700;
      width: 54px;
      transition: all 0.2s;
    }
    .nav-item.active {
      color: #0284c7;
    }
    .nav-bubble {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      transition: all 0.2s;
    }
    .nav-item.active .nav-bubble {
      background: #0284c7;
      color: #ffffff;
      transform: translateY(-4px);
      box-shadow: 0 6px 14px rgba(2, 132, 199, 0.35);
    }

    /* Toast Notification Alert */
    .toast-msg {
      position: fixed;
      bottom: 84px;
      left: 50%;
      transform: translateX(-50%);
      background: #0f172a;
      color: white;
      padding: 10px 18px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 700;
      z-index: 200;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s;
      box-shadow: 0 10px 25px rgba(0,0,0,0.2);
      text-align: center;
      max-width: 90%;
    }
    .toast-msg.show {
      opacity: 1;
    }

    .empty-state-card {
      text-align: center;
      padding: 30px 20px;
      color: #64748b;
    }
    .empty-state-card span {
      font-size: 36px;
      display: block;
      margin-bottom: 8px;
    }
  </style>
</head>
<body>

  <div class="app-viewport">
    
    <!-- Top System Mock Bar -->
    <div class="mobile-status-bar">
      <span id="system-clock">09:41</span>
      <div class="status-bar-icons">
        <span class="sync-indicator" id="sync-status-badge">● Supabase Live</span>
        <span>📶 5G</span>
        <span>🔋 100%</span>
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- SCREEN 1: LOGIN -->
    <!-- ============================================================ -->
    <div id="screen-login" class="app-screen active">
      <div class="login-brand">
        <div class="login-brand-icon">
          <img src="../simpul_logo_clean.png" onerror="this.src='../logo-sman12-munabarat.png'" alt="Logo">
        </div>
        <h1 id="login-portal-title">Portal Guru</h1>
        <p>Bersama Mendidik Generasi</p>
      </div>

      <div class="login-card">
        <div class="login-card-title">Selamat Datang</div>
        <div class="login-card-sub" id="login-sub-text">Silakan login menggunakan akun Guru Anda</div>

        <!-- Role Switcher -->
        <div class="role-switcher">
          <button type="button" class="role-btn active" id="btn-role-guru" onclick="switchLoginRole('guru')">Akun Guru</button>
          <button type="button" class="role-btn" id="btn-role-siswa" onclick="switchLoginRole('siswa')">Ruang Siswa</button>
        </div>

        <form id="form-login" onsubmit="handleLoginSubmit(event)">
          <div class="form-group">
            <label id="lbl-username">Username atau NIP</label>
            <div class="input-box">
              <span>👤</span>
              <input type="text" id="input-username" placeholder="Masukkan Username / NIP Guru" required value="admin">
            </div>
          </div>

          <div class="form-group" id="group-password">
            <label>Password</label>
            <div class="input-box">
              <span>🔒</span>
              <input type="password" id="input-password" placeholder="Masukkan Password" required value="admin123">
            </div>
          </div>

          <button type="submit" class="btn-primary" id="btn-submit-login">
            Masuk ke Portal ➔
          </button>
        </form>
      </div>

      <div class="login-footer-quote">
        "Pendidikan adalah investasi terbaik untuk masa depan bangsa"
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- SCREEN 2: BERANDA (HOME GURU & SISWA) -->
    <!-- ============================================================ -->
    <div id="screen-home" class="app-screen">
      <div class="home-header">
        <div class="user-profile-badge">
          <div class="user-avatar" id="home-user-avatar">
            👨‍🏫
          </div>
          <div>
            <div class="user-greeting" id="home-greeting">Selamat Pagi,</div>
            <div class="user-name" id="home-user-name">Memuat Data...</div>
            <div class="user-role-badge" id="home-user-role">Guru Pengampu</div>
          </div>
        </div>
        <button class="bell-btn" onclick="openUrgentModalManually()">
          🔔
          <span class="bell-badge" id="bell-unread-count">1</span>
        </button>
      </div>

      <!-- Kartu Identitas Sekolah (Terintegrasi dari Supabase Settings) -->
      <div class="school-id-card">
        <div class="school-id-icon">🏫</div>
        <div class="school-id-info">
          <div class="school-id-title" id="school-name-text">SMA Negeri 12 Muna Barat</div>
          <div class="school-id-year" id="school-academic-year">Tahun Ajaran 2024/2025 • Semester Ganjil</div>
        </div>
      </div>

      <!-- Banner Pengingat 20 Menit Masuk Kelas (OTOMATIS DARI SUPABASE SUBJECTS & STUDENTS) -->
      <div class="urgent-reminder-box" id="banner-urgent-reminder" style="display:none;">
        <div class="reminder-header-row">
          <div class="reminder-badge-urgent">⏰ 20 Menit Lagi Masuk</div>
          <div class="reminder-time-left" id="reminder-time-countdown">--:--</div>
        </div>
        <div class="reminder-class-info" id="reminder-class-text">
          Memuat jadwal mengajar...
        </div>
        <div class="reminder-student-roster" id="reminder-roster-preview">
          👥 <strong>Daftar Siswa yang akan masuk:</strong> Menghubungkan ke database...
        </div>
        <button class="btn-quick-absen" onclick="openAttendanceForUrgentClass()">
          ✏️ Buka Absensi Kelas Ini Sekarang ➔
        </button>
      </div>

      <!-- Banner Edukasi -->
      <div class="quote-banner">
        <h3>"Mendidik dengan Hati Mencetak Generasi Hebat"</h3>
        <p>Integritas • Karakter • Prestasi</p>
        <div class="quote-banner-icon">➔</div>
      </div>

      <!-- Grid 6 Menu Utama -->
      <div class="quick-menu-grid" id="main-quick-menu">
        <div class="menu-card" onclick="navTo('kelas')">
          <div class="menu-card-icon">👥</div>
          <div class="menu-card-title">Daftar Kelas</div>
        </div>
        <div class="menu-card" onclick="navTo('jadwal')">
          <div class="menu-card-icon">📅</div>
          <div class="menu-card-title">Jadwal Mengajar</div>
        </div>
        <div class="menu-card" onclick="navTo('absen')">
          <div class="menu-card-icon">📝</div>
          <div class="menu-card-title">Absen Siswa</div>
        </div>
        <div class="menu-card" onclick="navTo('ruang')">
          <div class="menu-card-icon">🏛️</div>
          <div class="menu-card-title">Ruang Belajar</div>
        </div>
        <div class="menu-card" onclick="navTo('ujian')">
          <div class="menu-card-icon">📄</div>
          <div class="menu-card-title">Ujian CBT</div>
        </div>
        <div class="menu-card" onclick="navTo('nilai')">
          <div class="menu-card-icon">📊</div>
          <div class="menu-card-title">Rekap Nilai</div>
        </div>
      </div>

      <!-- Pengumuman Highlight -->
      <div class="announcement-banner" onclick="navTo('pengumuman')">
        <div class="announcement-icon">📢</div>
        <div class="announcement-text">
          <div class="announcement-tag" id="home-announcement-title">Pengumuman Sekolah</div>
          <div class="announcement-sub" id="home-announcement-sub">Ketuk untuk membaca pengumuman terbaru</div>
        </div>
        <span>➔</span>
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- SCREEN 3: DAFTAR KELAS -->
    <!-- ============================================================ -->
    <div id="screen-kelas" class="app-screen">
      <div class="screen-header">
        <button class="back-btn" onclick="navTo('home')">←</button>
        <h2>Daftar Kelas</h2>
        <span style="font-size:18px;">📋</span>
      </div>

      <div class="search-bar-wrap">
        <div class="search-input-box">
          <span>🔍</span>
          <input type="text" id="input-search-class" placeholder="Cari nama kelas..." oninput="handleSearchClass(this.value)">
        </div>
      </div>

      <div class="class-card-list" id="class-container">
        <!-- Render dinamis dari tabel Classes -->
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- SCREEN 4: JADWAL MENGAJAR -->
    <!-- ============================================================ -->
    <div id="screen-jadwal" class="app-screen">
      <div class="screen-header">
        <button class="back-btn" onclick="navTo('home')">←</button>
        <h2>Jadwal Mengajar</h2>
        <span style="font-size:18px;">🗓️</span>
      </div>

      <div class="schedule-date-filter">
        <button onclick="changeScheduleDay(-1)" style="border:none; background:none; font-size:16px; font-weight:800; cursor:pointer;">‹</button>
        <span id="schedule-active-day-label">Hari Ini</span>
        <button onclick="changeScheduleDay(1)" style="border:none; background:none; font-size:16px; font-weight:800; cursor:pointer;">›</button>
      </div>

      <div class="schedule-list" id="schedule-container">
        <!-- Render dinamis dari tabel Subjects -->
