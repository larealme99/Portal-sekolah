    </div>

    <!-- ============================================================ -->
    <!-- SCREEN 5: ABSEN SISWA -->
    <!-- ============================================================ -->
    <div id="screen-absen" class="app-screen">
      <div class="screen-header">
        <button class="back-btn" onclick="navTo('home')">←</button>
        <h2>Absen Siswa</h2>
        <span style="font-size:18px;">✏️</span>
      </div>

      <div class="schedule-date-filter" style="margin-bottom:8px;">
        <span id="absen-today-str">Senin, 20 Oktober 2025</span>
      </div>

      <!-- Filter Dropdown Terintegrasi dari tabel Classes & Subjects -->
      <div style="display:flex; gap:8px; margin:0 20px 10px;">
        <select id="absen-select-class" onchange="onClassDropdownChange()" style="flex:1; padding:10px; border-radius:12px; border:1.5px solid #e2e8f0; font-weight:700; font-size:12px;">
          <option value="">Pilih Kelas...</option>
        </select>
        <select id="absen-select-subject" style="flex:1; padding:10px; border-radius:12px; border:1.5px solid #e2e8f0; font-weight:700; font-size:12px;">
          <option value="">Pilih Mapel...</option>
        </select>
      </div>

      <!-- Ringkasan Statistik -->
      <div class="attendance-stats-row">
        <div class="stat-pill">
          <div class="stat-pill-num" id="stat-total" style="color:#0f172a;">0</div>
          <div class="stat-pill-label">Total</div>
        </div>
        <div class="stat-pill">
          <div class="stat-pill-num" id="stat-hadir" style="color:#10b981;">0</div>
          <div class="stat-pill-label">Hadir</div>
        </div>
        <div class="stat-pill">
          <div class="stat-pill-num" id="stat-izin" style="color:#f59e0b;">0</div>
          <div class="stat-pill-label">Izin</div>
        </div>
        <div class="stat-pill">
          <div class="stat-pill-num" id="stat-sakit" style="color:#ef4444;">0</div>
          <div class="stat-pill-label">Sakit</div>
        </div>
      </div>

      <div class="search-bar-wrap" style="padding-top:4px;">
        <div class="search-input-box">
          <span>🔍</span>
          <input type="text" placeholder="Cari nama siswa..." oninput="handleSearchStudent(this.value)">
        </div>
      </div>

      <!-- Roster Absensi Siswa -->
      <div style="padding:0 20px 10px;" id="roster-container">
        <!-- Render dinamis dari tabel Students & Attendance -->
      </div>

      <button class="btn-save-attendance" id="btn-save-absen" onclick="saveAttendanceToSupabase()">
        💾 Simpan Presensi ke Database Supabase
      </button>
    </div>

    <!-- ============================================================ -->
    <!-- SCREEN 6: RUANG BELAJAR -->
    <!-- ============================================================ -->
    <div id="screen-ruang" class="app-screen">
      <div class="screen-header">
        <button class="back-btn" onclick="navTo('home')">←</button>
        <h2>Ruang Pembelajaran</h2>
        <span style="font-size:18px;">🏛️</span>
      </div>

      <div style="padding:14px 20px 20px;" id="rooms-container">
        <!-- Render modul / pembelajaran -->
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- SCREEN 7: UJIAN (CBT) -->
    <!-- ============================================================ -->
