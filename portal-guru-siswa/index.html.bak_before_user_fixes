<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Portal Guru & Ruang Siswa - Simpul Smandum</title>
  <link rel="manifest" href="manifest.json">
  <meta name="theme-color" content="#0284c7">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Supabase JS Client CDN -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <!-- Load Konfigurasi Supabase Eksisting Sekolah -->
  <script src="../supabase-config.js"></script>

  <style>
    :root {
      --primary: #0284c7;
      --primary-dark: #0369a1;
      --primary-light: #38bdf8;
      --primary-subtle: #e0f2fe;
      --primary-gradient: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
      --accent-green: #10b981;
      --accent-yellow: #f59e0b;
      --accent-red: #ef4444;
      --accent-purple: #8b5cf6;
      --bg-canvas: #f1f5f9;
      --bg-card: #ffffff;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border-color: #e2e8f0;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --shadow-soft: 0 4px 20px -2px rgba(15, 23, 42, 0.06);
      --shadow-hover: 0 10px 25px -4px rgba(2, 132, 199, 0.15);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--bg-canvas);
      color: var(--text-main);
      display: flex;
      justify-content: center;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Container HP Mobile Simulator */
    .app-viewport {
      width: 100%;
      max-width: 440px;
      min-height: 100vh;
      background: #f8fafc;
      position: relative;
      box-shadow: 0 0 40px rgba(0,0,0,0.12);
      display: flex;
      flex-direction: column;
      padding-bottom: 74px; /* Clearance for fixed bottom nav */
    }

    /* Top Status Bar Mockup */
    .mobile-status-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 20px 6px;
      font-size: 13px;
      font-weight: 700;
      color: #0f172a;
      background: #ffffff;
      z-index: 50;
      border-bottom: 1px solid #f1f5f9;
    }
    .status-bar-icons {
      display: flex;
      gap: 6px;
      align-items: center;
    }
    .sync-indicator {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 10px;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 6px;
      background: #dcfce7;
      color: #15803d;
    }
    .sync-indicator.syncing {
      background: #fef3c7;
      color: #b45309;
    }
    .sync-indicator.offline {
      background: #fee2e2;
      color: #b91c1c;
    }

    /* Content Area Scrollable */
    .app-screen {
      flex: 1;
      overflow-y: auto;
      padding-bottom: 30px;
      display: none;
    }
    .app-screen.active {
      display: block;
      animation: fadeIn 0.22s ease-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Top App Bar Header */
    .screen-header {
      padding: 14px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #ffffff;
      border-bottom: 1px solid #f1f5f9;
      position: sticky;
      top: 0;
      z-index: 40;
    }
    .screen-header h2 {
      font-size: 17px;
      font-weight: 800;
      color: #0f172a;
    }
    .back-btn {
      background: #f1f5f9;
      border: none;
      font-size: 18px;
      cursor: pointer;
      color: #334155;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 50%;
    }
    .back-btn:active {
      background: #e2e8f0;
    }

    /* ============================================================ */
    /* 1. LAYAR LOGIN */
    /* ============================================================ */
    #screen-login {
      background: linear-gradient(180deg, #f0f9ff 0%, #ffffff 40%, #0284c7 100%);
      min-height: 100vh;
      display: none;
      flex-direction: column;
      justify-content: space-between;
      padding: 24px 20px;
      position: relative;
      margin-bottom: -74px; /* cancels out viewport padding on login */
    }
    #screen-login.active {
      display: flex;
    }
    .login-brand {
      text-align: center;
      margin-top: 10px;
    }
    .login-brand-icon {
      width: 72px;
      height: 72px;
      margin: 0 auto 10px;
      background: #ffffff;
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 10px 25px rgba(2, 132, 199, 0.2);
    }
    .login-brand-icon img {
      width: 48px;
      height: 48px;
      object-fit: contain;
    }
    .login-brand h1 {
      font-size: 24px;
      font-weight: 800;
      color: #0284c7;
      letter-spacing: -0.5px;
    }
    .login-brand p {
      font-size: 12px;
      color: #64748b;
      margin-top: 2px;
      font-weight: 500;
    }

    .login-card {
      background: #ffffff;
      border-radius: 22px;
      padding: 22px;
      box-shadow: 0 15px 35px rgba(2, 132, 199, 0.12);
      margin-top: 16px;
    }
    .login-card-title {
      font-size: 18px;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 4px;
    }
    .login-card-sub {
      font-size: 12px;
      color: #64748b;
      margin-bottom: 16px;
    }

    .role-switcher {
      display: flex;
      background: #f1f5f9;
      border-radius: 12px;
      padding: 4px;
      margin-bottom: 16px;
    }
    .role-btn {
      flex: 1;
      padding: 8px 10px;
      border: none;
      background: transparent;
      border-radius: 9px;
      font-size: 13px;
      font-weight: 700;
      color: #64748b;
      cursor: pointer;
      transition: all 0.2s;
    }
    .role-btn.active {
      background: #ffffff;
      color: #0284c7;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .form-group {
      margin-bottom: 14px;
    }
    .form-group label {
      display: block;
      font-size: 12px;
      font-weight: 700;
      color: #475569;
      margin-bottom: 6px;
    }
    .input-box {
      display: flex;
      align-items: center;
      background: #f8fafc;
      border: 1.5px solid #e2e8f0;
      border-radius: 14px;
      padding: 12px 14px;
      gap: 10px;
      transition: border-color 0.2s;
    }
    .input-box:focus-within {
      border-color: #0284c7;
      background: #ffffff;
    }
    .input-box input, .input-box select, .input-box textarea {
      border: none;
      background: transparent;
      outline: none;
      width: 100%;
      font-size: 14px;
      color: #0f172a;
    }
    .btn-primary {
      width: 100%;
      padding: 13px;
      background: var(--primary-gradient);
      color: white;
      border: none;
      border-radius: 14px;
      font-size: 14px;
      font-weight: 800;
      cursor: pointer;
      margin-top: 8px;
      box-shadow: 0 8px 20px rgba(2, 132, 199, 0.3);
      transition: transform 0.15s;
    }
    .btn-primary:active {
      transform: scale(0.98);
    }
    .login-footer-quote {
      text-align: center;
      color: #ffffff;
      font-size: 11px;
      opacity: 0.9;
      padding: 10px 0;
    }

    /* ============================================================ */
    /* 2. LAYAR BERANDA (HOME) */
    /* ============================================================ */
    .home-header {
      padding: 12px 20px 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #ffffff;
    }
    .user-profile-badge {
      display: flex;
      align-items: center;
      gap: 12px;
      cursor: pointer;
    }
    .user-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: #e0f2fe;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      border: 2px solid #bae6fd;
      overflow: hidden;
      flex-shrink: 0;
    }
    .user-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .user-greeting {
      font-size: 11px;
      color: #64748b;
      font-weight: 600;
    }
    .user-name {
      font-size: 15px;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.2;
    }
    .user-role-badge {
      font-size: 11px;
      color: #0284c7;
      font-weight: 700;
    }
    .bell-btn {
      position: relative;
      background: #f1f5f9;
      border: none;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 18px;
    }
    .bell-badge {
      position: absolute;
      top: -2px;
      right: -2px;
      background: #ef4444;
      color: white;
      font-size: 10px;
      font-weight: 800;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid #ffffff;
    }

    .school-id-card {
      margin: 12px 20px;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 12px 14px;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .school-id-icon {
      width: 38px;
      height: 38px;
      background: #e0f2fe;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }
    .school-id-title {
      font-size: 13px;
      font-weight: 800;
      color: #0f172a;
    }
    .school-id-year {
      font-size: 11px;
      color: #64748b;
      font-weight: 500;
    }

    /* PENGINGAT JADWAL 20 MENIT (GURU ONLY) */
    .urgent-reminder-box {
      margin: 0 20px 16px;
      background: #fffbeb;
      border: 1.5px solid #fde68a;
      border-radius: 18px;
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      box-shadow: 0 4px 12px rgba(245, 158, 11, 0.1);
      transition: all 0.3s;
    }
    .reminder-header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .reminder-badge-urgent {
      background: #d97706;
      color: white;
      font-size: 11px;
      font-weight: 800;
      padding: 3px 8px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .reminder-time-left {
      font-size: 12px;
      font-weight: 800;
      color: #b45309;
    }
    .reminder-class-info {
      font-size: 14px;
      font-weight: 800;
      color: #78350f;
    }
    .reminder-student-roster {
      font-size: 11px;
      color: #92400e;
      line-height: 1.4;
      background: rgba(255, 255, 255, 0.7);
      padding: 8px 10px;
      border-radius: 10px;
      border: 1px solid #fef3c7;
    }
    .btn-quick-absen {
      background: #d97706;
      color: white;
      border: none;
      padding: 9px;
      border-radius: 10px;
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .quote-banner {
      margin: 0 20px 18px;
      background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
      border-radius: 20px;
      padding: 18px 20px;
      color: white;
      position: relative;
      overflow: hidden;
      box-shadow: 0 10px 20px rgba(2, 132, 199, 0.18);
    }
    .quote-banner h3 {
      font-size: 14px;
      font-weight: 800;
      max-width: 75%;
      line-height: 1.4;
    }
    .quote-banner p {
      font-size: 11px;
      opacity: 0.9;
      margin-top: 4px;
    }
    .quote-banner-icon {
      position: absolute;
      right: 16px;
      bottom: 16px;
      width: 36px;
      height: 36px;
      background: rgba(255, 255, 255, 0.2);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
    }

    /* Quick Menus */
    .quick-menu-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin: 0 20px 18px;
    }
    .quick-menu-student-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
      margin: 0 20px 18px;
    }
    .student-big-card {
      background: #ffffff;
      border-radius: 20px;
      padding: 16px 18px;
      display: flex;
      align-items: center;
      gap: 16px;
      border: 1px solid #e2e8f0;
      box-shadow: var(--shadow-soft);
      cursor: pointer;
      transition: all 0.2s;
    }
    .student-big-card:active {
      transform: scale(0.97);
      background: #f8fafc;
    }
    .student-card-icon {
      width: 52px;
      height: 52px;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
      flex-shrink: 0;
    }
    .student-card-info h4 {
      font-size: 15px;
      font-weight: 800;
      color: #0f172a;
    }
    .student-card-info p {
      font-size: 12px;
      color: #64748b;
      margin-top: 2px;
    }

    .menu-card {
      background: #ffffff;
      border-radius: 18px;
      padding: 16px 8px;
      text-align: center;
      border: 1px solid #f1f5f9;
      box-shadow: var(--shadow-soft);
      cursor: pointer;
      transition: all 0.2s;
    }
    .menu-card:active {
      transform: scale(0.96);
      background: #f8fafc;
    }
    .menu-card-icon {
      width: 46px;
      height: 46px;
      border-radius: 14px;
      background: #0284c7;
      color: #ffffff;
      margin: 0 auto 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25);
    }
    .menu-card-title {
      font-size: 11px;
      font-weight: 700;
      color: #334155;
    }

    .announcement-banner {
      margin: 0 20px 18px;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 12px 14px;
      display: flex;
      align-items: center;
      gap: 12px;
      cursor: pointer;
    }
    .announcement-icon {
      width: 36px;
      height: 36px;
      background: #0284c7;
      color: white;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      flex-shrink: 0;
    }
    .announcement-text {
      flex: 1;
    }
    .announcement-tag {
      font-size: 12px;
      font-weight: 800;
      color: #0f172a;
    }
    .announcement-sub {
      font-size: 11px;
      color: #64748b;
    }

    /* ============================================================ */
    /* FILTER TAB SWITCHERS (RIWAYAT SAYA VS SEMUA) */
    /* ============================================================ */
    .filter-tab-bar {
      display: flex;
      background: #e2e8f0;
      border-radius: 12px;
      padding: 4px;
      margin-bottom: 14px;
      gap: 4px;
    }
    .filter-tab-btn {
      flex: 1;
      padding: 8px 10px;
      border: none;
      background: transparent;
      border-radius: 9px;
      font-size: 12px;
      font-weight: 700;
      color: #64748b;
      cursor: pointer;
      transition: all 0.2s;
    }
    .filter-tab-btn.active {
      background: #ffffff;
      color: #0284c7;
      box-shadow: 0 2px 6px rgba(0,0,0,0.06);
    }

    /* ACTION BUTTONS PRIMARY */
    .btn-action-primary {
      width: 100%;
      padding: 12px 16px;
      background: var(--primary-gradient);
      color: white;
      border: none;
      border-radius: 14px;
      font-size: 13px;
      font-weight: 800;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 4px 14px rgba(2, 132, 199, 0.25);
      transition: transform 0.15s;
    }
    .btn-action-primary:active {
      transform: scale(0.98);
    }

    /* ============================================================ */
    /* KARTU RUANG PEMBELAJARAN & ULANGAN/UJIAN */
    /* ============================================================ */
    .item-entity-card {
      background: #ffffff;
      border-radius: 18px;
      padding: 16px;
      border: 1px solid #e2e8f0;
      box-shadow: var(--shadow-soft);
      display: flex;
      flex-direction: column;
      gap: 10px;
      transition: all 0.2s;
    }
    .card-top-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 10px;
    }
    .card-title-text {
      font-size: 15px;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.3;
    }
    .badge-status {
      font-size: 10px;
      font-weight: 800;
      padding: 3px 8px;
      border-radius: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      flex-shrink: 0;
    }
    .badge-active { background: #dcfce7; color: #15803d; }
    .badge-draft { background: #fef3c7; color: #b45309; }
    .badge-closed { background: #f1f5f9; color: #64748b; }

    .card-meta-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
    }
    .meta-tag-pill {
      font-size: 11px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 8px;
      background: #f1f5f9;
      color: #475569;
    }
    .meta-tag-pill.blue {
      background: #e0f2fe;
      color: #0369a1;
    }
    .meta-tag-pill.green {
      background: #dcfce7;
      color: #15803d;
    }
    .meta-tag-pill.purple {
      background: #f3e8ff;
      color: #7e22ce;
    }

    .card-desc-snippet {
      font-size: 12px;
      color: #64748b;
      line-height: 1.45;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .token-chip-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #f8fafc;
      padding: 8px 12px;
      border-radius: 12px;
      border: 1px dashed #cbd5e1;
    }
    .token-label-text {
      font-size: 11px;
      font-weight: 700;
      color: #64748b;
    }
    .token-value-code {
      font-size: 12px;
      font-weight: 800;
      color: #0284c7;
      letter-spacing: 1px;
      background: #e0f2fe;
      padding: 2px 8px;
      border-radius: 6px;
      cursor: pointer;
    }

    .card-action-btns-row {
      display: flex;
      gap: 8px;
      align-items: center;
      margin-top: 4px;
      padding-top: 8px;
      border-top: 1px solid #f1f5f9;
    }
    .btn-card-action {
      flex: 1;
      padding: 8px 12px;
      border-radius: 10px;
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      border: none;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: all 0.15s;
    }
    .btn-card-action.primary {
      background: #0284c7;
      color: white;
    }
    .btn-card-action.secondary {
      background: #f1f5f9;
      color: #334155;
    }
    .btn-card-action.danger {
      background: #fee2e2;
      color: #b91c1c;
      flex: 0 0 auto;
      padding: 8px 12px;
    }

    /* ============================================================ */
    /* 3. LAYAR PROFIL */
    /* ============================================================ */
    .profile-hero-card {
      background: #ffffff;
      border-radius: 24px;
      padding: 24px 20px;
      text-align: center;
      border: 1px solid #e2e8f0;
      box-shadow: var(--shadow-soft);
      margin-bottom: 16px;
    }
    .profile-avatar-wrapper {
      position: relative;
      width: 88px;
      height: 88px;
      margin: 0 auto 12px;
      cursor: pointer;
    }
    .profile-avatar-large {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background: #e0f2fe;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 42px;
      border: 3px solid #bae6fd;
      overflow: hidden;
      box-shadow: 0 6px 18px rgba(2, 132, 199, 0.2);
    }
    .profile-avatar-large img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .profile-avatar-badge {
      position: absolute;
      bottom: 2px;
      right: 2px;
      background: #0284c7;
      color: white;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
