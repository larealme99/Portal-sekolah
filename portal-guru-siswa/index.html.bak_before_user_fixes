    async function handleLoginSubmit(e) {
      e.preventDefault();
      requestNotificationPermission();

      const usernameVal = document.getElementById('input-username').value.trim();
      const passwordVal = document.getElementById('input-password').value.trim();

      if (!supabaseClient) {
        initSupabase();
      }

      setSyncStatus(false, 'Memverifikasi...');

      try {
        if (currentRole === 'guru') {
          // Login Guru / Admin ke tabel 'Users'
          const hashed = await hashPassword(passwordVal);

          let query = supabaseClient.from('Users').select('*').eq('Status', 'active');
          const { data: users, error } = await query.or(`Username.eq."${usernameVal}",NIP.eq."${usernameVal}"`);

          if (error) throw error;

          if (!users || users.length === 0) {
            showToast('Username atau NIP tidak ditemukan / akun belum aktif.');
            setSyncStatus(true, 'Supabase Live');
            return;
          }

          const u = users[0];
          if (u.Password === hashed || u.Password === passwordVal) {
            currentUser = {
              role: u.Role || 'guru',
              id: u.ID,
              username: u.Username,
              name: u['Nama Lengkap'] || u.Username,
              nip: u.NIP || '-',
              phone: u.Telepon || '',
              photo: u['Foto Profil URL'] || ''
            };
            localStorage.setItem('smandum_active_user', JSON.stringify(currentUser));
            loginSuccess();
          } else {
            showToast('Password yang dimasukkan salah!');
            setSyncStatus(true, 'Supabase Live');
          }
        } else {
          // Login Siswa ke tabel 'Students' berdasarkan NIS
          const { data: students, error } = await supabaseClient.from('Students').select('*').eq('NIS', usernameVal);
          if (error) throw error;

          if (!students || students.length === 0) {
            showToast('NIS tidak terdaftar di database sekolah.');
            setSyncStatus(true, 'Supabase Live');
            return;
          }

          const s = students[0];
          currentUser = {
            role: 'siswa',
            id: s['ID Siswa'],
            nis: s.NIS,
            name: s['Nama Siswa'],
            classId: s['ID Kelas'],
            className: s['Nama Kelas'],
            gender: s['Jenis Kelamin'],
            photo: s['Foto Profil URL'] || localStorage.getItem(`student_photo_${s.NIS}`) || ''
          };
          localStorage.setItem('smandum_active_user', JSON.stringify(currentUser));
          loginSuccess();
        }
      } catch (err) {
        console.error('Error saat login:', err);
        showToast('Gagal memverifikasi login: ' + (err.message || 'Koneksi error'));
        setSyncStatus(false, 'Gagal Sinkron');
      }
    }

