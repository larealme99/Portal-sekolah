    // Hashing password konsisten dengan supabase-bridge.js
    async function hashPassword(str) {
      try {
        const salted = (str || '') + 'SALT_PORTAL_SEKOLAH_2024';
        const msgBuffer = new TextEncoder().encode(salted);
        const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
        const hashArray = Array.from(new Uint8Array(hashBuffer));
        return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
      } catch (e) {
        return str;
      }
    }

    function generateUniqueId(prefix) {
      return prefix + Date.now().toString(36).toUpperCase() + Math.random().toString(36).substr(2, 4).toUpperCase();
    }

    function generateRandomToken(len = 6) {
      const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
      let tok = '';
      for (let i = 0; i < len; i++) {
        tok += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      return tok;
    }

    // Inisialisasi Supabase
    function initSupabase() {
      const cfg = window.PORTAL_CONFIG || {};
      if (cfg.SUPABASE_URL && cfg.SUPABASE_ANON_KEY && !cfg.SUPABASE_URL.includes('GANTI_DENGAN')) {
        try {
          supabaseClient = window.supabase.createClient(cfg.SUPABASE_URL, cfg.SUPABASE_ANON_KEY);
          setSyncStatus(true, 'Supabase Live');
          return true;
        } catch (e) {
          console.error('Gagal menghubungkan Supabase:', e);
          setSyncStatus(false, 'Supabase Error');
          return false;
        }
      } else {
        setSyncStatus(false, 'Config Belum Diisi');
        return false;
      }
    }

