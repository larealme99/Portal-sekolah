    function renderRooms(filterKeyword = '') {
      const container = document.getElementById('rooms-container');
      if (!container) return;

      let list = dbLearnings || [];

      // Hitung counter tab Guru
      if (currentUser && currentUser.role !== 'siswa') {
        const myItems = list.filter(item => {
          const authorId = item['ID Guru'] || item.idGuru || '';
          const authorName = (item['Nama Guru'] || item.namaGuru || '').toLowerCase();
          return authorId === currentUser.id || authorName.includes(currentUser.name.toLowerCase());
        });
        const cntMine = document.getElementById('count-ruang-mine');
        const cntAll = document.getElementById('count-ruang-all');
        if (cntMine) cntMine.innerText = myItems.length;
        if (cntAll) cntAll.innerText = list.length;

        if (activeRuangTab === 'mine') {
          list = myItems;
        }
      } else if (currentUser && currentUser.role === 'siswa') {
        // Siswa hanya melihat materi kelasnya atau 'Semua Kelas'
        list = list.filter(item => {
          const kls = item['Nama Kelas'] || item.namaKelas || '';
          const klsId = item['ID Kelas'] || item.idKelas || '';
          return kls === 'Semua Kelas' || kls === currentUser.className || klsId === currentUser.classId;
        });
      }

      if (filterKeyword) {
        const kw = filterKeyword.toLowerCase();
        list = list.filter(it => {
          const title = (it['Judul'] || it.judul || '').toLowerCase();
          const subj = (it['Nama Mapel'] || it.namaMapel || '').toLowerCase();
          return title.includes(kw) || subj.includes(kw);
