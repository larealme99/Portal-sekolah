        const status = item['Status'] || item.status || 'active';

        const isMine = currentUser && (
          (item['ID Guru'] && item['ID Guru'] === currentUser.id) || 
          (guru && guru.toLowerCase().includes(currentUser.name.toLowerCase()))
        );

        return `
