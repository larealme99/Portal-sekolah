    function renderExams(filterKeyword = '') {
      const container = document.getElementById('exams-container');
      if (!container) return;

      let list = dbExams || [];

      // Hitung counter tab Guru
      if (currentUser && currentUser.role !== 'siswa') {
        const myItems = list.filter(item => {
          const authorId = item['ID Guru'] || item.idGuru || '';
          const authorName = (item['Nama Guru'] || item.namaGuru || '').toLowerCase();
          return authorId === currentUser.id || authorName.includes(currentUser.name.toLowerCase());
        });
        const cntMine = document.getElementById('count-ujian-mine');
        const cntAll = document.getElementById('count-ujian-all');
        if (cntMine) cntMine.innerText = myItems.length;
        if (cntAll) cntAll.innerText = list.length;

        if (activeUjianTab === 'mine') {
          list = myItems;
        }
      } else if (currentUser && currentUser.role === 'siswa') {
        list = list.filter(item => {
          const kls = item['Nama Kelas'] || item.namaKelas || '';
          const klsId = item['ID Kelas'] || item.idKelas || '';
          return kls === 'Semua Kelas' || kls === currentUser.className || klsId === currentUser.classId;
        });
      }

      if (filterKeyword) {
        const kw = filterKeyword.toLowerCase();
        list = list.filter(it => {
          const title = (it['Judul Ujian'] || it.judul || '').toLowerCase();
          const subj = (it['Nama Mapel'] || it.namaMapel || '').toLowerCase();
          return title.includes(kw) || subj.includes(kw);
        });
      }

      if (list.length === 0) {
        container.innerHTML = `
          <div class="empty-state-card">
            <span>📝</span>
            <p>Belum ada jadwal ulangan / ujian ${activeUjianTab === 'mine' ? 'yang Anda buat' : 'tersedia'}.</p>
          </div>
        `;
        return;
      }

      container.innerHTML = list.map(ex => {
        const id = ex['ID Ujian'] || ex.id;
        const judul = ex['Judul Ujian'] || ex.judul || 'Ulangan Harian';
        const mapel = ex['Nama Mapel'] || ex.namaMapel || 'Mapel';
        const kelas = ex['Nama Kelas'] || ex.namaKelas || 'Semua Kelas';
        const durasi = ex['Durasi (menit)'] || ex.durasi || 60;
        const jmlSoal = ex['Jumlah Soal'] || ex.jumlahSoal || 5;
        const token = ex['Token'] || ex.token || '-';
        const status = ex['Status'] || ex.status || 'active';
        const guru = ex['Nama Guru'] || ex.namaGuru || 'Guru';

        const isMine = currentUser && (
          (ex['ID Guru'] && ex['ID Guru'] === currentUser.id) || 
          (guru && guru.toLowerCase().includes(currentUser.name.toLowerCase()))
        );

        return `
          <div class="item-entity-card">
            <div class="card-top-row">
              <div class="card-title-text">${judul}</div>
              <span class="badge-status ${status === 'active' ? 'badge-active' : 'badge-draft'}">
                ${status === 'active' ? 'Aktif' : 'Draft'}
              </span>
            </div>

            <div class="card-meta-tags">
              <span class="meta-tag-pill blue">📖 ${mapel}</span>
              <span class="meta-tag-pill green">👥 ${kelas}</span>
              <span class="meta-tag-pill">⏱️ ${durasi} Menit</span>
              <span class="meta-tag-pill purple">❓ ${jmlSoal} Soal</span>
            </div>

            <div class="token-chip-row">
              <span class="token-label-text">Token Masuk Ujian:</span>
              <span class="token-value-code" onclick="copyToClipboard('${token}')" title="Klik untuk salin token">
                🔑 ${token} 📋
              </span>
            </div>

            <div class="card-action-btns-row">
              ${currentUser && currentUser.role === 'siswa' ? `
                <button class="btn-card-action primary" onclick="openTakeExamModal('${id}')">
                  📝 Mulai Kerjakan Ulangan ➔
                </button>
              ` : `
                <button class="btn-card-action primary" onclick="openExamResultsModal('${id}', '${judul}')">
                  📊 Hasil Nilai Siswa
                </button>
                ${isMine ? `
                  <button class="btn-card-action secondary" onclick="openEditExam('${id}')">
