    async function checkUpcomingClassReminder() {
      if (!currentUser || currentUser.role === 'siswa' || dbSubjects.length === 0) return;

      const now = new Date();
      const hariIni = HARI_INDO[now.getDay()];
      const jamSekarang = now.getHours();
      const menitSekarang = now.getMinutes();
      const totalMenitSekarang = jamSekarang * 60 + menitSekarang;

      const jadwalHariIni = dbSubjects.filter(s => {
        const matchHari = (s.Hari || '').trim().toLowerCase() === hariIni.toLowerCase();
        return matchHari && s['Jam Mulai'];
      });

      let foundUrgent = null;
      let minDiff = 999999;

      for (const jdw of jadwalHariIni) {
        const [hMulai, mMulai] = jdw['Jam Mulai'].split(':').map(Number);
        if (isNaN(hMulai)) continue;
        const totalMenitMulai = hMulai * 60 + (mMulai || 0);
        const selisih = totalMenitMulai - totalMenitSekarang;

        if (selisih >= 0 && selisih <= 25) {
          if (selisih < minDiff) {
            minDiff = selisih;
            foundUrgent = { ...jdw, diffMinutes: selisih };
          }
        }
      }

      const banner = document.getElementById('banner-urgent-reminder');
      if (foundUrgent) {
        currentUrgentSubject = foundUrgent;
        if (banner) banner.style.display = 'flex';
        const countdownEl = document.getElementById('reminder-time-countdown');
        if (countdownEl) countdownEl.innerText = `${foundUrgent.diffMinutes} Menit Lagi (${foundUrgent['Jam Mulai']})`;
        
        const classTxt = document.getElementById('reminder-class-text');
        if (classTxt) classTxt.innerText = `${foundUrgent['Nama Kelas']} • ${foundUrgent['Nama Mapel']} (${foundUrgent['Ruangan'] || 'Ruang Kelas'})`;

        const siswaKelas = dbStudents.filter(st => st['ID Kelas'] === foundUrgent['ID Kelas'] || st['Nama Kelas'] === foundUrgent['Nama Kelas']);
        urgentStudentsCache = siswaKelas;

        const countText = `${siswaKelas.length} Siswa`;
        const listText = siswaKelas.map((s, idx) => `${idx + 1}. ${s['Nama Siswa']}`).slice(0, 8).join(', ') + (siswaKelas.length > 8 ? ` ...dan ${siswaKelas.length - 8} siswa lainnya` : '');
        
        const rosterPrev = document.getElementById('reminder-roster-preview');
        if (rosterPrev) rosterPrev.innerHTML = `👥 <strong>Daftar ${countText} yang akan masuk:</strong> ${listText || 'Siswa belum terdaftar di kelas ini'}`;

        const slotKey = `${foundUrgent['ID Mapel']}_${foundUrgent['Jam Mulai']}_${now.toDateString()}`;
        if (!notifiedSlots.has(slotKey) && foundUrgent.diffMinutes <= 20) {
          notifiedSlots.add(slotKey);
          if (navigator.vibrate) navigator.vibrate([200, 100, 200, 100, 200]);
        }
      } else {
        if (banner) banner.style.display = 'none';
      }
    }

