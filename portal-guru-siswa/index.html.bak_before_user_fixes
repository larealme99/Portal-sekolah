    async function onClassDropdownChange(preselectSubjectId = null) {
      const selClass = document.getElementById('absen-select-class');
      const selSubj = document.getElementById('absen-select-subject');
      const selectedClassVal = selClass.value;

      if (!selectedClassVal) {
        renderAttendanceRoster([]);
        return;
      }

      const subjectsInClass = dbSubjects.filter(s => s['ID Kelas'] === selectedClassVal || s['Nama Kelas'] === selectedClassVal);
      selSubj.innerHTML = '<option value="">-- Pilih Mapel --</option>' + subjectsInClass.map(s => `
        <option value="${s['ID Mapel']}">${s['Nama Mapel']} (${s.Hari || '-'})</option>
      `).join('');

      if (preselectSubjectId) selSubj.value = preselectSubjectId;
      else if (subjectsInClass.length > 0) selSubj.value = subjectsInClass[0]['ID Mapel'];

      const classStudents = dbStudents.filter(s => s['ID Kelas'] === selectedClassVal || s['Nama Kelas'] === selectedClassVal);
      const todayISO = new Date().toISOString().split('T')[0];
      activeAttendanceRecords = {};

      if (supabaseClient) {
        try {
          const { data: existingAtt } = await supabaseClient
            .from('Attendance')
            .select('*')
            .eq('Tanggal', todayISO)
            .or(`ID Kelas.eq."${selectedClassVal}",Nama Kelas.eq."${selectedClassVal}"`);

          if (existingAtt && existingAtt.length > 0) {
            existingAtt.forEach(r => {
              activeAttendanceRecords[r['NIS Siswa']] = {
                status: r.Status || 'Hadir',
                idAbsen: r['ID Absen']
              };
            });
          }
        } catch (e) {
          console.warn('Gagal memuat absensi eksisting:', e);
        }
      }

      renderAttendanceRoster(classStudents);
    }

    function renderAttendanceRoster(studentsList, filterKeyword = '') {
      const container = document.getElementById('roster-container');
      if (!container) return;

      const filtered = studentsList.filter(s => {
        return (s['Nama Siswa'] || '').toLowerCase().includes(filterKeyword.toLowerCase()) ||
               (s.NIS || '').includes(filterKeyword);
      });

      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="empty-state-card">
            <span>👥</span>
            <p>Tidak ada siswa di kelas ini.</p>
          </div>
        `;
        updateAttendanceStats(0, 0, 0, 0);
        return;
      }

      let countHadir = 0;
      let countIzin = 0;
      let countSakit = 0;

      container.innerHTML = filtered.map((st, i) => {
        const curStatus = activeAttendanceRecords[st.NIS] ? activeAttendanceRecords[st.NIS].status : 'Hadir';
        if (curStatus === 'Hadir') countHadir++;
        else if (curStatus === 'Izin') countIzin++;
        else if (curStatus === 'Sakit') countSakit++;

        const tagClass = curStatus === 'Hadir' ? 'tag-hadir' : (curStatus === 'Izin' ? 'tag-izin' : (curStatus === 'Sakit' ? 'tag-sakit' : 'tag-alpa'));

        return `
          <div class="roster-card" id="roster-row-${st.NIS}">
            <div class="roster-info">
              <div class="roster-avatar">👤</div>
              <div>
                <div class="roster-name">${i + 1}. ${st['Nama Siswa']}</div>
                <div class="roster-nis">NIS: ${st.NIS}</div>
              </div>
            </div>
            <button class="status-tag-toggle ${tagClass}" onclick="cycleStudentStatus('${st.NIS}', this)">
              ${curStatus}
            </button>
          </div>
        `;
      }).join('');

      updateAttendanceStats(filtered.length, countHadir, countIzin, countSakit);
    }

    function cycleStudentStatus(nis, btn) {
      const current = btn.innerText.trim();
      let next = 'Hadir';
      if (current === 'Hadir') next = 'Izin';
      else if (current === 'Izin') next = 'Sakit';
      else if (current === 'Sakit') next = 'Alpa';
      else next = 'Hadir';

      btn.innerText = next;
      btn.className = 'status-tag-toggle ' + (next === 'Hadir' ? 'tag-hadir' : (next === 'Izin' ? 'tag-izin' : (next === 'Sakit' ? 'tag-sakit' : 'tag-alpa')));

      if (!activeAttendanceRecords[nis]) {
        activeAttendanceRecords[nis] = { status: next, idAbsen: null };
      } else {
        activeAttendanceRecords[nis].status = next;
      }

      recalcStats();
    }

    function recalcStats() {
      const btns = document.querySelectorAll('#roster-container .status-tag-toggle');
      let hadir = 0, izin = 0, sakit = 0;
      btns.forEach(b => {
        const txt = b.innerText.trim();
        if (txt === 'Hadir') hadir++;
        else if (txt === 'Izin') izin++;
        else if (txt === 'Sakit') sakit++;
      });
      updateAttendanceStats(btns.length, hadir, izin, sakit);
    }

    function updateAttendanceStats(total, hadir, izin, sakit) {
      document.getElementById('stat-total').innerText = total;
      document.getElementById('stat-hadir').innerText = hadir;
      document.getElementById('stat-izin').innerText = izin;
      document.getElementById('stat-sakit').innerText = sakit;
    }

    function handleSearchStudent(val) {
      const selClass = document.getElementById('absen-select-class');
      const selectedClassVal = selClass ? selClass.value : '';
      const classStudents = dbStudents.filter(s => s['ID Kelas'] === selectedClassVal || s['Nama Kelas'] === selectedClassVal);
      renderAttendanceRoster(classStudents, val);
    }

    async function saveAttendanceToSupabase() {
      const selClass = document.getElementById('absen-select-class');
      const selSubj = document.getElementById('absen-select-subject');
      const selectedClassVal = selClass ? selClass.value : '';
      const selectedSubjVal = selSubj ? selSubj.value : '';

      if (!selectedClassVal) {
        showToast('Pilih kelas terlebih dahulu!');
        return;
      }

      const classObj = dbClasses.find(c => c['ID Kelas'] === selectedClassVal || c['Nama Kelas'] === selectedClassVal) || {};
      const subjObj = dbSubjects.find(s => s['ID Mapel'] === selectedSubjVal) || {};
      const classStudents = dbStudents.filter(s => s['ID Kelas'] === selectedClassVal || s['Nama Kelas'] === selectedClassVal);

      if (classStudents.length === 0) {
        showToast('Tidak ada siswa di kelas ini untuk disimpan.');
        return;
      }

      const btn = document.getElementById('btn-save-absen');
      btn.innerText = '⏳ Menyimpan ke Database...';
      btn.disabled = true;

      try {
        const now = new Date();
        const todayISO = now.toISOString().split('T')[0];
        const hariIni = HARI_INDO[now.getDay()];
        const jamSekarang = String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0');

        const rowsToInsert = classStudents.map(st => {
          const statusVal = activeAttendanceRecords[st.NIS] ? activeAttendanceRecords[st.NIS].status : 'Hadir';
          const newId = generateUniqueId('ABS');

          return {
            'ID Absen': newId,
            'Tanggal': todayISO,
            'Hari': hariIni,
            'ID Kelas': classObj['ID Kelas'] || selectedClassVal,
            'Nama Kelas': classObj['Nama Kelas'] || selectedClassVal,
            'ID Guru': currentUser.id || '',
            'Nama Guru': currentUser.name || '',
            'ID Mapel': subjObj['ID Mapel'] || '',
            'Nama Mapel': subjObj['Nama Mapel'] || '',
            'NIS Siswa': st.NIS,
            'Nama Siswa': st['Nama Siswa'],
            'Status': statusVal,
            'Keterangan': '',
            'Jam Absen': jamSekarang,
            'Diubah Oleh': currentUser.name || 'Guru',
            'Waktu Ubah': now.toISOString()
          };
        });

        if (subjObj['ID Mapel']) {
          await supabaseClient.from('Attendance').delete()
            .eq('Tanggal', todayISO)
            .eq('ID Kelas', classObj['ID Kelas'] || selectedClassVal)
            .eq('ID Mapel', subjObj['ID Mapel']);
        }

        const { error } = await supabaseClient.from('Attendance').insert(rowsToInsert);
        if (error) throw error;

        showToast('✅ Berhasil! Data absensi tersimpan ke Supabase.');
      } catch (err) {
        console.error('Gagal menyimpan absensi:', err);
        showToast('Gagal menyimpan: ' + err.message);
      } finally {
        btn.innerText = '💾 Simpan Presensi ke Database Supabase';
        btn.disabled = false;
      }
    }

    // ============================================================
    // RENDER: PENGUMUMAN & NILAI
    // ============================================================
    function renderAnnouncements() {
      const container = document.getElementById('announcement-list-container');
      if (!container) return;

      if (dbAnnouncements.length === 0) {
        container.innerHTML = `
          <div class="empty-state-card">
            <span>📢</span>
            <p>Belum ada pengumuman aktif dari sekolah.</p>
          </div>
        `;
        return;
      }

      const latest = dbAnnouncements[0];
      const hTitle = document.getElementById('home-announcement-title');
      const hSub = document.getElementById('home-announcement-sub');
      if (hTitle) hTitle.innerText = latest.Judul || 'Pengumuman Sekolah';
      if (hSub) hSub.innerText = (latest.Konten || '').slice(0, 48) + '...';

      container.innerHTML = dbAnnouncements.map(a => `
        <div class="class-item-card" style="margin-bottom:10px;">
          <div style="font-size:24px;">📢</div>
          <div style="flex:1;">
            <div style="font-size:13px; font-weight:800; color:#0f172a;">${a.Judul}</div>
            <div style="font-size:10px; color:#64748b; margin-top:2px;">Kategori: ${a.Kategori || 'Umum'} • Prioritas: ${a.Prioritas || 'Normal'}</div>
            <div style="font-size:12px; color:#475569; margin-top:6px; line-height:1.4;">${a.Konten || ''}</div>
          </div>
        </div>
      `).join('');
    }

    function renderGrades() {
      const container = document.getElementById('grades-container');
      if (!container) return;

      if (dbGrades.length === 0) {
        container.innerHTML = `
          <div class="empty-state-card">
            <span>📊</span>
            <p>Belum ada data nilai di database 'Grades'.</p>
          </div>
        `;
        return;
      }

      let sum = 0, max = -Infinity, min = Infinity;
      dbGrades.forEach(g => {
        const n = Number(g.Nilai || g['Nilai Akhir'] || 0);
        sum += n;
        if (n > max) max = n;
        if (n < min) min = n;
      });

      const avg = (sum / dbGrades.length).toFixed(1);
      document.getElementById('grade-avg').innerText = avg;
      document.getElementById('grade-max').innerText = max === -Infinity ? '-' : max;
      document.getElementById('grade-min').innerText = min === Infinity ? '-' : min;

      container.innerHTML = dbGrades.slice(0, 15).map(g => `
        <div style="display:flex; justify-content:space-between; align-items:center; background:white; padding:12px 16px; border-radius:14px; margin-bottom:8px; border:1px solid #f1f5f9; box-shadow:var(--shadow-soft);">
          <div>
            <div style="font-size:13px; font-weight:800; color:#0f172a;">${g['Nama Siswa'] || 'Siswa'}</div>
            <div style="font-size:11px; color:#64748b;">${g['Nama Mapel'] || g['Judul Ujian'] || 'Ujian'}</div>
          </div>
          <span style="font-size:15px; font-weight:800; color:#0284c7;">${g.Nilai || g['Nilai Akhir'] || '-'}</span>
        </div>
      `).join('');
    }

    // ============================================================
    // NAVIGASI & CLOCK
    // ============================================================
    function navTo(screenName) {
      document.querySelectorAll('.app-screen').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));

      const targetScreen = document.getElementById(`screen-${screenName}`);
      if (targetScreen) targetScreen.classList.add('active');

      const activeBtn = document.getElementById(`nav-btn-${screenName}`);
      if (activeBtn) activeBtn.classList.add('active');

      if (screenName === 'profil') {
        renderProfileScreen();
      }

      window.scrollTo(0, 0);
    }

    function updateClock() {
      const now = new Date();
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      const clk = document.getElementById('system-clock');
      if (clk) clk.innerText = `${h}:${m}`;
      
      const tanggalFormat = `${HARI_INDO[now.getDay()]}, ${now.getDate()} ${BULAN_INDO[now.getMonth()]} ${now.getFullYear()}`;
      const tLabel = document.getElementById('absen-today-str');
      if (tLabel) tLabel.innerText = tanggalFormat;
    }
    setInterval(updateClock, 1000);
    updateClock();

    // Inisialisasi awal saat halaman selesai dimuat
    window.addEventListener('DOMContentLoaded', () => {
      initSupabase();

      // Cek apakah ada sesi login tersimpan
      const savedUser = localStorage.getItem('smandum_active_user');
      if (savedUser) {
        try {
          currentUser = JSON.parse(savedUser);
          currentRole = currentUser.role || 'guru';
          loginSuccess();
        } catch (e) {
          localStorage.removeItem('smandum_active_user');
        }
      }
    });
  </script>
